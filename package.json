{
  "name": "@lennix1337/pi-agent-desktop",
  "version": "0.1.0",
  "description": "Computer use for the Pi coding agent: see and control native Windows, macOS and Linux apps (click, type, read, screenshot) through the OS accessibility tree, powered by vercel-labs/agent-desktop.",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "e2e": "node --import tsx scripts/e2e-notepad.ts",
    "release": "npm version patch -m \"release %s\" && git push --follow-tags"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "pi-coding-agent",
    "computer-use",
    "desktop-automation",
    "desktop",
    "accessibility",
    "ui-automation",
    "rpa",
    "agent",
    "ai-agent",
    "windows",
    "macos",
    "linux",
    "agent-desktop",
    "screenshot"
  ],
  "type": "module",
  "dependencies": {
    "agent-desktop": "1.0.2",
    "typebox": "1.3.27"
  },
  "license": "MIT",
  "author": "lennix1337",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lennix1337/pi-agent-desktop.git"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "files": [
    "src",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.4.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/lennix1337/pi-agent-desktop#readme",
  "bugs": {
    "url": "https://github.com/lennix1337/pi-agent-desktop/issues"
  }
}
